# Скопировать в .env и заполнить. Сам .env в git не попадает никогда —
# см. первый блок .gitignore.

# --- База -------------------------------------------------------------------
# Приложение ходит через пулер Supavisor (transaction mode).
DATABASE_URL=postgresql+psycopg://postgres:CHANGEME@127.0.0.1:6543/postgres
# Alembic — прямым соединением: миграции с пулером в transaction mode
# конфликтуют.
DATABASE_URL_DIRECT=postgresql+psycopg://postgres:CHANGEME@127.0.0.1:5432/postgres

# --- Supabase ---------------------------------------------------------------
# Адрес шлюза Supabase (Envoy, сервис `api-gw`, см. infra/supabase/README.md).
# На боевом api живёт в контейнере и ходит по сети `supabase_default`:
#     SUPABASE_URL=http://api-gw:8000
# 127.0.0.1 внутри контейнера указывает на сам контейнер, а не на сервер, —
# с ним вход ответит «Служба входа не отвечает». Значение ниже годится
# только для процесса, запущенного прямо на хосте.
SUPABASE_URL=http://127.0.0.1:8000
# Без него шлюз отвечает на вход 401/403, и бэкенд говорит «Вход настроен
# неверно». Это ANON_KEY из .env Supabase.
SUPABASE_ANON_KEY=
# ВНИМАНИЕ: service_role обходит все проверки прав. Только на бэкенде,
# никогда во фронтенде и никогда в логах.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Google -----------------------------------------------------------------
# Идентификаторы таблиц не подставлены намеренно: репозиторий публичный.
# Сами по себе доступа они не дают, но и объявлять структуру данных наружу
# незачем. Значения — в .env на сервере.
# Один файл ключа на сервер, права 0600. Не копия в каждом каталоге.
GOOGLE_CREDENTIALS_PATH=/etc/kitchen-platform/service_account.json
# GOOGLE_REFRESH_TIMEOUT больше не читается: google-auth обновляет токен с
# таймаутом самого запроса (GOOGLE_CONNECT_TIMEOUT, GOOGLE_READ_TIMEOUT), а
# отдельный таймаут обновления не применял. Строку в .env сервера можно убрать.
SHEETS_ID_KITCHEN=
SHEETS_ID_COMPETITORS=
SHEETS_ID_INGREDIENT_CARDS=
SHEETS_ID_TASTINGS=
# Фото карточек ингредиентов — папка на «Моём диске» владельца (фото загружает
# сервисный аккаунт, место — его) или на общем диске. Сервисному аккаунту —
# право добавлять файлы («Редактор»; на общем диске — «Менеджер контента»).
# По ссылке — не больше «Читателя»: открытая на изменение папка — ошибка
# проверки, фото удалит кто угодно. Платформа доступы не выдаёт.
# Id папки — только в .env на сервере. Проверка всей настройки:
#     docker compose -f infra/docker-compose.yml exec api python scripts/check_cards_setup.py
DRIVE_CARDS_FOLDER_ID=
# «drive.file» — доступ только к файлам, созданным платформой; «drive» — ко
# всему, что открыто сервисному аккаунту. Выставляется по выводу скрипта проверки.
DRIVE_SCOPE=drive.file
# Синхронизация «лист → база»: воркер раз в столько секунд читает книги.
# Не меньше 60.
# SYNC_INTERVAL_SECONDS=300
# Данные старше этого — полоса «не обновляются» на сайте: три пропущенных цикла.
# Строго больше SYNC_INTERVAL_SECONDS.
# SYNC_STALE_AFTER_SECONDS=900

# --- LLM --------------------------------------------------------------------
# Только polza.ai: прямой доступ к OpenAI и Anthropic из РФ закрыт.
POLZA_API_KEY=
POLZA_BASE_URL=https://api.polza.ai/v1
LLM_MODEL=gpt-4o-mini
# Суточный потолок расходов, рубли, на всех вместе; сутки — по Москве.
# Превышение останавливает вызовы до полуночи.
LLM_DAILY_BUDGET_RUB=300
# Модель, которая читает фото этикеток. Проверка ключа, баланса и модели:
#     docker compose -f infra/docker-compose.yml exec api python scripts/check_cards_setup.py --llm
LLM_VISION_MODEL=qwen/qwen3.6-plus
# Сколько секунд ждать ответа модели (5–80). Повтор после таймаута — только
# если вызов с ним укладывается в 170 с: nginx держит запрос 180 с.
# LLM_VISION_TIMEOUT_SECONDS=60
# Сколько этикеток один повар может распознать за сутки.
# LLM_LABEL_CALLS_PER_USER_DAILY=40

# --- Приложение -------------------------------------------------------------
# На боевом — APP_ENV=production.
APP_ENV=development
# Заполняется деплоем: хеш коммита отдаётся в /healthz.
APP_VERSION=dev
# Явный список источников. Звёздочка с куками запрещена спецификацией,
# так что «*» здесь означало бы либо неработающий вход, либо дыру.
CORS_ORIGINS=["https://art.karppacho.ru"]
# Куки входа только по HTTPS. .env на сервере создают копированием этого
# файла, и false здесь отдал бы access-токен открытым текстом по любому
# http://…/api/… до первого визита по HSTS. Разработке true не мешает:
# Chrome и Firefox считают http://localhost безопасным контекстом и куку
# с Secure на нём ставят.
SESSION_COOKIE_SECURE=true
